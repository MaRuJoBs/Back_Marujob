# Este arquivo é um exemplo de como deve ser o arquivo .env.
# Copie o conteúdo deste arquivo para um arquivo chamado .env e
# preencha as variáveis de ambiente com os valores corretos.

MODE=DEVELOPMENT  # DEVELOPMENT, PRODUCTION, MIGRATE
DEBUG=True
WEB_CONCURRENCY=4
SECRET_KEY=django_insecure_gere_uma_chave_secreta
# DATABASE_URL=[database_url]
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name
PASSAGE_APP_ID=THE_APP_ID_PROVIDED_BY_PASSAGE
PASSAGE_API_KEY=THE_API_KEY_PROVIDED_BY_PASSAGE
MY_IP=127.0.0.1
GOOGLE_CLIENT_ID=seu_client_id.apps.googleusercontent.com
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=
WEBPUSH_VAPID_SUBJECT=mailto:admin@example.com
# Chat em tempo real: sem REDIS_URL o channel layer fica em memória (só para um único processo).
# REDIS_URL=redis://localhost:6379/0
CHAT_MAX_UPLOAD_MB=10
# Produção: configure SECRET_KEY aleatória (50+ caracteres), DEBUG=False,
# ALLOWED_HOSTS explícitos, DATABASE_URL e origens HTTPS (sem caminho).
# DATABASE_URL é obrigatória em PRODUCTION e MIGRATE; SQLite explícito continua aceito.
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Ative somente se o proxy controlado remover/substituir X-Forwarded-Proto.
TRUST_X_FORWARDED_PROTO=False
MAX_IMAGE_UPLOAD_BYTES=5242880
# Limites ativos em PRODUCTION: autenticação por IP e senhas por usuário.
# Com REDIS_URL, o cache de produção compartilha os contadores entre processos.
AUTH_THROTTLE_RATE=20/min
PASSWORD_THROTTLE_RATE=5/min

# Web Push opcional. Gere um par VAPID por ambiente e mantenha a chave privada no servidor.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
